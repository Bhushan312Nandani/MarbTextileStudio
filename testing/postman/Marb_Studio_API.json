{
	"info": {
		"_postman_id": "marb-studio-ecommerce-api-v1",
		"name": "Marb Studio — Apparel E-Commerce API",
		"description": "Comprehensive test suite for Marb Studio Public, Protected Customer, and Admin Endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01. Auth",
			"item": [
				{
					"name": "Register Customer",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"first_name\": \"Zain\",\n  \"last_name\": \"Ahmed\",\n  \"email\": \"zain.test@marbtextile.test\",\n  \"password\": \"SecurePass@123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/public/auth/register", "host": ["{{baseUrl}}"], "path": ["public", "auth", "register"] }
					}
				},
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"if (json.accessToken) { pm.collectionVariables.set('accessToken', json.accessToken); pm.collectionVariables.set('refreshToken', json.refreshToken); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@marbtextile.test\",\n  \"password\": \"Customer@123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/public/auth/login", "host": ["{{baseUrl}}"], "path": ["public", "auth", "login"] }
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"if (json.accessToken) { pm.collectionVariables.set('adminToken', json.accessToken); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@marbtextile.test\",\n  \"password\": \"Admin@123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/public/auth/login", "host": ["{{baseUrl}}"], "path": ["public", "auth", "login"] }
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/public/auth/refresh", "host": ["{{baseUrl}}"], "path": ["public", "auth", "refresh"] }
					}
				},
				{
					"name": "Get Profile (Me)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": { "raw": "{{baseUrl}}/public/auth/me", "host": ["{{baseUrl}}"], "path": ["public", "auth", "me"] }
					}
				}
			]
		},
		{
			"name": "02. Public Catalog",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/public/products", "host": ["{{baseUrl}}"], "path": ["public", "products"] }
					}
				},
				{
					"name": "Search Products",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/public/products/search?q=Hood", "host": ["{{baseUrl}}"], "path": ["public", "products", "search"], "query": [{ "key": "q", "value": "Hood" }] }
					}
				},
				{
					"name": "Get Categories",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/public/categories", "host": ["{{baseUrl}}"], "path": ["public", "categories"] }
					}
				}
			]
		},
		{
			"name": "03. Cart & Checkout",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": { "raw": "{{baseUrl}}/public/cart", "host": ["{{baseUrl}}"], "path": ["public", "cart"] }
					}
				},
				{
					"name": "Place Order",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"couponId\": null\n}"
						},
						"url": { "raw": "{{baseUrl}}/public/orders", "host": ["{{baseUrl}}"], "path": ["public", "orders"] }
					}
				},
				{
					"name": "List User Orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
						"url": { "raw": "{{baseUrl}}/public/orders", "host": ["{{baseUrl}}"], "path": ["public", "orders"] }
					}
				}
			]
		},
		{
			"name": "04. Admin APIs",
			"item": [
				{
					"name": "Admin Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
						"url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
					}
				},
				{
					"name": "Admin List Products",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
						"url": { "raw": "{{baseUrl}}/admin/products", "host": ["{{baseUrl}}"], "path": ["admin", "products"] }
					}
				},
				{
					"name": "Admin List Orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
						"url": { "raw": "{{baseUrl}}/admin/orders", "host": ["{{baseUrl}}"], "path": ["admin", "orders"] }
					}
				}
			]
		}
	]
}
